# Copy this file to .env and fill in the values before syncing episodes.

# Standard AWS credentials consumed by the AWS CLI.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2

# Destination prefix for recorded episodes.
# Episodes are uploaded preserving their path under RECORDINGS_ROOT, e.g.
# recordings/20260531/episode_210157_a9036076 -> s3://bucket/prefix/20260531/episode_210157_a9036076/
S3_EPISODE_URI=s3://your-bucket/path/to/episodes

# Optional defaults used by scripts/sync_episodes_to_s3.py.
RECORDINGS_ROOT=recordings
EPISODE_MIN_AGE_SECONDS=60
